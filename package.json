{
  "name": "regis-agents",
  "version": "0.1.0",
  "description": "REGIS: Reverse Engineer Game Into Survival. An end-to-end, game-agnostic agent skill and project toolkit.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "regis": "bin/regis.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run check",
    "verify": "npm run check && npm test && npm run build && npm run test:package"
  },
  "keywords": [
    "regis",
    "agent-skills",
    "reverse-engineering",
    "survivors",
    "game-development",
    "rea"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sxela/regis.git"
  },
  "homepage": "https://github.com/Sxela/regis#readme",
  "bugs": {
    "url": "https://github.com/Sxela/regis/issues"
  }
